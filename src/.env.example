# Copy this file to `.env` and fill in the real values before running `docker-compose up`.
# The app reads these environment variables at runtime. Values without defaults are required.

# Database settings (used to initialize the MySQL container and by the app)
DB_NAME=my_wellness_db
DB_USERNAME=appuser
DB_HOST=host
DB_PASSWORD=changeme

# Optional: timezone used when converting datetimes (defaults to UTC)
DB_TZ_DATES=UTC

# MyWellness credentials (required to log in and scrape sessions)
MYWELLNESS_USERNAME=you@example.com
MYWELLNESS_PASSWORD=supersecretpassword

# Optional run controls for `main.py` (either use DAYS_BACK or START_DATE/END_DATE)
# DAYS_BACK: number of days back from today to sync (default 7)
DAYS_BACK=7
# Or set explicit dates in YYYY-MM-DD format
#START_DATE=2026-05-01
#END_DATE=2026-05-25
